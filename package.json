{
  "name": "writing-buddy-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @writing-buddy/desktop dev",
    "build": "pnpm --filter @writing-buddy/desktop build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "qa:inventory": "node scripts/qa/inventory.mjs",
    "qa:traceability": "node scripts/qa/inventory.mjs && node scripts/qa/traceability.mjs",
    "qa:validate": "node scripts/qa/inventory.mjs && node scripts/qa/traceability.mjs --strict",
    "qa:plan": "node scripts/qa/inventory.mjs && node scripts/qa/traceability.mjs && node scripts/qa/dependencies.mjs",
    "qa:fixtures": "node scripts/qa/fixtures.mjs",
    "qa:record-baseline": "node scripts/qa/record-baseline.mjs",
    "qa:baseline:frontend": "node scripts/qa/supported-acceptance.mjs",
    "qa:baseline:rust": "node scripts/qa/supported-cargo.mjs",
    "qa:record-convergence": "node scripts/qa/record-convergence.mjs",
    "self-test": "node scripts/self-test/run.mjs",
    "self-test:plan": "node scripts/self-test/run.mjs --dry-run",
    "self-test:full": "node scripts/self-test/run.mjs --all",
    "self-test:release": "node scripts/self-test/run.mjs --release",
    "acceptance:gate-g": "node scripts/acceptance/capture-phase-1.2a-gate-g.mjs",
    "acceptance:gate-h": "node scripts/acceptance/validate-phase-1.2a-gate-h.mjs",
    "acceptance:phase-1.2b": "node scripts/acceptance/validate-phase-1.2b-creation-journey.mjs",
    "acceptance:phase-1.2c": "node scripts/acceptance/validate-phase-1.2b-creation-journey.mjs --phase-1.2c",
    "acceptance:phase-1.2e": "node scripts/acceptance/validate-phase-1.2e-market-hierarchy.mjs",
    "acceptance:phase-1.2f": "node scripts/acceptance/validate-phase-1.2f-task-closure.mjs",
    "acceptance:phase-1.2g": "node scripts/acceptance/validate-phase-1.2g-export-trust.mjs",
    "acceptance:phase-1.2h": "node scripts/acceptance/validate-phase-1.2h-work-export-backup.mjs",
    "acceptance:phase-1.2i": "node scripts/acceptance/validate-phase-1.2i-draft-import.mjs",
    "acceptance:phase-1.2j": "node scripts/acceptance/validate-phase-1.2j-word-interoperability.mjs",
    "acceptance:phase-1.2k": "node scripts/acceptance/validate-phase-1.2k-daily-writing-progress.mjs",
    "acceptance:phase-1.2l": "node scripts/acceptance/validate-phase-1.2l-whole-work-consistency.mjs",
    "acceptance:phase-1.2m": "node scripts/acceptance/validate-phase-1.2m-scene-plot-grid.mjs",
    "acceptance:phase-1.2n": "node scripts/acceptance/validate-phase-1.2n-publish-readiness.mjs",
    "acceptance:phase-1.2o": "node scripts/acceptance/validate-phase-1.2o-chapter-lifecycle.mjs",
    "acceptance:phase-1.2p": "node scripts/acceptance/validate-phase-1.2p-delivery-freshness.mjs",
    "acceptance:phase-1.2q": "node scripts/acceptance/validate-phase-1.2q-author-confirmed-release.mjs",
    "acceptance:genre-to-draft": "node scripts/acceptance/validate-genre-to-draft-gate-d.mjs",
    "acceptance:genre-to-draft:gate-d": "node scripts/acceptance/validate-genre-to-draft-gate-d.mjs",
    "acceptance:complete-novel": "node scripts/acceptance/validate-complete-novel.mjs",
    "acceptance:user-detail": "node scripts/acceptance/validate-user-detail-soak.mjs",
    "acceptance:user-stress": "node scripts/acceptance/run-user-stress.mjs",
    "fixtures:generate": "node scripts/compatibility/generate-fixtures.mjs",
    "compatibility:report": "node scripts/compatibility/create-report.mjs",
    "tauri": "pnpm --filter @writing-buddy/desktop tauri",
    "tauri:dev": "pnpm --filter @writing-buddy/desktop tauri dev",
    "tauri:build": "pnpm --filter @writing-buddy/desktop tauri build",
    "acceptance": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "acceptance:full-regression": "node scripts/acceptance/run-full-regression.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
