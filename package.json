{
  "name": "writing-buddy-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @writing-buddy/desktop dev",
    "build": "pnpm --filter @writing-buddy/desktop build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "self-test": "node scripts/self-test/run.mjs",
    "self-test:plan": "node scripts/self-test/run.mjs --dry-run",
    "self-test:full": "node scripts/self-test/run.mjs --all",
    "self-test:release": "node scripts/self-test/run.mjs --release",
    "acceptance:gate-g": "node scripts/acceptance/capture-phase-1.2a-gate-g.mjs",
    "acceptance:gate-h": "node scripts/acceptance/validate-phase-1.2a-gate-h.mjs",
    "acceptance:phase-1.2b": "node scripts/acceptance/validate-phase-1.2b-creation-journey.mjs",
    "acceptance:phase-1.2c": "node scripts/acceptance/validate-phase-1.2b-creation-journey.mjs --phase-1.2c",
	"acceptance:phase-1.2f": "node scripts/acceptance/validate-phase-1.2f-task-closure.mjs",
	"acceptance:phase-1.2g": "node scripts/acceptance/validate-phase-1.2g-export-trust.mjs",
	"acceptance:phase-1.2h": "node scripts/acceptance/validate-phase-1.2h-work-export-backup.mjs",
	"acceptance:phase-1.2j": "node scripts/acceptance/validate-phase-1.2j-word-interoperability.mjs",
	"acceptance:phase-1.2k": "node scripts/acceptance/validate-phase-1.2k-daily-writing-progress.mjs",
	"acceptance:phase-1.2l": "node scripts/acceptance/validate-phase-1.2l-whole-work-consistency.mjs",
    "acceptance:genre-to-draft": "node scripts/acceptance/validate-genre-to-draft-gate-d.mjs",
    "acceptance:genre-to-draft:gate-d": "node scripts/acceptance/validate-genre-to-draft-gate-d.mjs",
    "acceptance:complete-novel": "node scripts/acceptance/validate-complete-novel.mjs",
    "fixtures:generate": "node scripts/compatibility/generate-fixtures.mjs",
    "compatibility:report": "node scripts/compatibility/create-report.mjs",
    "tauri": "pnpm --filter @writing-buddy/desktop tauri",
    "tauri:dev": "pnpm --filter @writing-buddy/desktop tauri dev",
    "tauri:build": "pnpm --filter @writing-buddy/desktop tauri build",
    "acceptance": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
